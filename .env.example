# ---------------------------------------------------------------------------
# Application environment. Copy to .env for local development.
#
# These are the ONLY values read from the environment. AI provider credentials
# and Resend credentials are NOT here by design: they are stored encrypted in
# PostgreSQL and configured through the admin panel.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by prisma and the app.
DATABASE_URL=postgresql://notetaker:notetaker@localhost:5432/ai_notetaker?schema=public

# Redis connection string used by BullMQ and the rate limiter.
REDIS_URL=redis://localhost:6379

# Used to derive the AES-256-GCM key for stored credentials and to hash tokens.
# Must be at least 32 characters. Rotating it invalidates stored credentials.
APP_SECRET=change-me-to-a-random-value-of-at-least-32-chars

# Absolute public origin of the web service. Magic links and CSRF checks use it.
APP_URL=http://localhost:3000

# Seeded by prisma/seed.ts (idempotent; never overwrites an existing password).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# BullMQ worker concurrency.
WORKER_CONCURRENCY=2

# Upload limit in bytes (default 100 MB).
MAX_UPLOAD_SIZE=104857600

# Optional.
NODE_ENV=development
LOG_LEVEL=info

# --- docker-compose only ---------------------------------------------------
POSTGRES_USER=notetaker
POSTGRES_PASSWORD=notetaker
POSTGRES_DB=ai_notetaker
WEB_PORT=3000
